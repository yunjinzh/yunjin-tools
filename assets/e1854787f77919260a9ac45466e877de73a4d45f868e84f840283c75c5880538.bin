 let mh=Math.min(rh-head,rw/aspect),mw=mh*aspect,left=rx+(rw-mw)/2,top=ry+head+(rh-head-mh)/2,body='';
 function line(row,key,amp,color,opacity){let segments=[],current=[],lat=b[3]-(row+.5)/nr*(b[3]-b[1]);for(let i=0;i<nx;i++){let lon=b[0]+(i+.5)/nx*(b[2]-b[0]),v=C.sample(grid,key,lon,lat);if(mask[(row*nx+i)*4+3]>100&&Number.isFinite(v)){let a=key==='dem'?C.clamp(Math.max(0,v)/stats.eCap,0,1):C.popScale(v,stats.pCap,s.curve);current.push([left+(i+.5)/nx*mw,top+(row+.5)/nr*mh-a*amp]);}else if(current.length){segments.push(current);current=[]}}if(current.length)segments.push(current);let baseline=top+(row+.5)/nr*mh;
 for(let pts of segments){if(pts.length<2)continue;let d=pts.map((v,i)=>(i?'L':'M')+v[0].toFixed(2)+' '+v[1].toFixed(2)).join(' '),fill=`${d} L${pts.at(-1)[0].toFixed(2)} ${baseline.toFixed(2)} L${pts[0][0].toFixed(2)} ${baseline.toFixed(2)} Z`;body+=`<path d="${fill}" fill="${pal.bg}"/><path d="${fill}" fill="${color}" fill-opacity="${opacity}"/><path d="${d}" fill="none" stroke="${color}" stroke-opacity=".8" stroke-width="${s.lineWidth*(compact?.7:1)}" stroke-linejoin="round"/>`;}}
 for(let row=0;row<nr;row++){if(view!=='population'&&grid.dem)line(row,'dem',ampE,pal.e,view==='overlay'?.26:.12);if(view!=='elevation'&&grid.pop)line(row,'pop',ampP,pal.p,view==='overlay'?.12:.07)}
 return body;
}
function southInset(x,y,w,h,pal){const b=[105,3,125,24],g=asFc(rawChina.features.filter(f=>f.properties.adcode===460000||f.properties.adcode==='100000_JD'));let id='south'+x;return `<defs><clipPath id="${id}"><rect x="${x}" y="${y}" width="${w}" height="${h}"/></clipPath></defs><rect x="${x}" y="${y}" width="${w}" height="${h}" fill="none" stroke="${pal.muted}" opacity=".4"/><g clip-path="url(#${id})">${outline(g,b,x,y,w,h,pal.e,.9)}</g>`+svgText(x+8,y+15,'南海诸岛',9,pal.muted)+svgText(x+8,y+h-7,'边界定位附图',7,pal.muted)}
function mapPanel(view,rect,s,compact=false){let [x,y,w,h]=rect,pal=PALETTES[state.palette],out='',bodyTop=y,bodyH=h;
 if(state.isChina&&!compact){bodyH=h-135;out+=ridgePlot(state.grid,state.geo,view,[x,y,w,bodyH],s,state.stats);let iw=160,gap=18,baseX=x+(w-(3*iw+2*gap))/2,iy=y+h-110;state.insets.forEach((ins,i)=>{let ix=baseX+i*(iw+gap);out+=`<rect x="${ix}" y="${iy}" width="${iw}" height="110" rx="1" fill="none" stroke="${pal.muted}" stroke-opacity=".28"/>`;out+=svgText(ix+9,iy+15,ins.label,10,pal.ink);out+=ridgePlot(ins.grid,ins.geo,view,[ix+5,iy+17,iw-10,82],{...s,height:50,popHeight:55,lines:100},ins.stats,true);});out+=southInset(x+w-94,y+bodyH-130,75,104,pal);
 }else out+=ridgePlot(state.grid,state.geo,view,rect,s,state.stats,compact);
 return out;
}
function render(){if(!state.grid)return;const pal=PALETTES[state.palette],s=getSettings();let W=1200,H=940,out=`<rect width="1200" height="940" fill="${pal.bg}"/>`,v=state.view;
 if(v==='triptych'){
  out+=`<path d="M388 60V865" stroke="${pal.muted}" stroke-opacity=".2"/>`;
  out+=svgText(50,91,'ELEVATION',28,pal.e,'font-family="Arial,sans-serif" font-weight="300" letter-spacing="2"');out+=svgText(50,115,state.name+' / 高程',10,pal.muted);out+=mapPanel('elevation',[28,125,340,308],s,true);
  out+=svgText(50,505,'POPULATION',27,pal.p,'font-family="Arial,sans-serif" font-weight="300" letter-spacing="1"');out+=svgText(50,529,state.name+' / 人口密度',10,pal.muted);out+=mapPanel('population',[28,535,340,310],s,true);
  if(s.labels){out+=svgText(450,94,s.title||'山川与人海',30,pal.ink,'font-family="Source Han Serif SC,Noto Serif SC,serif" letter-spacing="5"');out+=svgText(452,121,state.en+' / ELEVATION × POPULATION',10,pal.muted,'letter-spacing="2"')}
  out+=mapPanel('overlay',[410,160,740,680],{...s,height:s.height*.8,popHeight:s.popHeight*.8});
 }else{
  if(s.labels){out+=svgText(62,85,s.title||'山川与人海',34,pal.ink,'font-family="Source Han Serif SC,Noto Serif SC,serif" letter-spacing="6"');out+=svgText(65,113,state.en+' / '+(v==='overlay'?'ELEVATION × POPULATION':v==='elevation'?'ELEVATION':'POPULATION'),10,pal.muted,'font-family="Arial,sans-serif" letter-spacing="2.3"');out+=svgText(1138,77,'RIDGE',11,pal.muted,'text-anchor="end" letter-spacing="3"');out+=svgText(1138,94,'ATLAS / 01',8,pal.muted,'text-anchor="end" letter-spacing="2"')}
  out+=mapPanel(v,[60,s.labels?135:40,1080,s.labels?672:760],s);
 }
 if(s.labels){let y=H-68;out+=`<path d="M62 ${y-18}H1138" stroke="${pal.muted}" stroke-opacity=".25"/>`;if(v!=='population')out+=`<path d="M64 ${y}h21" stroke="${pal.e}" stroke-width="2"/>`+svgText(94,y+4,'高程 / m',10,pal.muted);if(v!=='elevation')out+=`<path d="M215 ${y}h21" stroke="${pal.p}" stroke-width="2"/>`+svgText(245,y+4,`人口密度 / 人/km² · ${state.grid.year}`,10,pal.muted);out+=svgText(1138,y+4,state.isChina?'中国 · 含台湾、香港、澳门':'固定纬度剖面 · 独立视觉尺度',10,pal.muted,'text-anchor="end"')}
 out+=svgText(62,H-29,`${state.grid.dem?'Mapzen Terrain Tiles · ':''}${state.grid.pop?'WorldPop / Esri (CC BY 4.0) · ':''}${state.boundarySource}`,8,pal.muted);out+=svgText(1138,H-29,`${state.grid.pop?state.grid.year+' POP · '+(state.grid.resolution||'1km')+' · ':''}GRID ${state.grid.width} × ${state.grid.height}`,8,pal.muted,'text-anchor="end"');
 artSvg=`<svg xmlns="http://www.w3.org/2000/svg" width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(state.name+'高程与人口剖面线图')}" font-family="Microsoft YaHei,Noto Sans SC,sans-serif"><title>${esc(state.name+' / '+s.title)}</title><desc>${esc(`高程以米为单位；人口为 ${state.grid.year} 年密度估计，单位人/km²。人口 ${s.curve} 缩放，视觉截断 ${Math.round(state.stats.pCap)} 人/km²；原值不截断。缺测留空。`)}</desc>${out}</svg>`;$('artwork').innerHTML=artSvg;
 document.querySelectorAll('[data-view]').forEach(b=>b.classList.toggle('active',b.dataset.view===v));$('canvasMeta').textContent=`横向剖面 · ${s.lines} 线 · ${state.grid.year}`;
}
function requestRender(){cancelAnimationFrame(raf);raf=requestAnimationFrame(render)}
function refreshMetrics(){let t=state.stats,n=v=>Math.round(v).toLocaleString('zh-CN');$('regionHeading').textContent=state.name+' ';let span=document.createElement('span');span.textContent=state.en;$('regionHeading').append(span);$('scopeMetric').textContent=state.isChina?'全国 · 34 个省级行政区':state.name;$('heightMetric').textContent=state.grid.dem?`${n(t.eLow)} — ${n(t.eMax)} m`:'未启用';$('popMetric').textContent=state.grid.pop?`${n(t.pMax)} 人/km²`:'未启用';$('coverageMetric').textContent=`${state.grid.dem?(t.eCoverage*100).toFixed(1)+'%':'—'} · ${state.grid.pop?(t.pCoverage*100).toFixed(1)+'%':'—'}`;}
async function makeInsets(){let specs=[['taiwan',710000,'台湾'],['hongkong',810000,'香港'],['macao',820000,'澳门']];return Promise.all(specs.map(async([id,code,label])=>{let grid=await fileJson(`data/${id}-grid.json`),geo=asFc([china.features.find(f=>f.properties.adcode===code)]);return{label,grid,geo,stats:statistics(grid,geo)}}))}
function ensureChina(geo,name){if(!/^(中国|全国|中华人民共和国|china)$/i.test(name.trim()))return;for(let [name,x,y] of [['台湾',120.98,23.7],['香港',114.16,22.32],['澳门',113.55,22.18]])if(!C.contains(geo,x,y))throw Error(`以“中国”命名的区域缺少${name}覆盖，请补全边界或使用准确区域名称`);}
async function loadTerrain(bbox,width,height,parentSignal,onProgress){const child=new AbortController(),abort=()=>child.abort();parentSignal.addEventListener('abort',abort,{once:true});if(parentSignal.aborted)child.abort();const signal=child.signal;let [minx,miny,maxx,maxy]=bbox,ratio=(maxx-minx)/360;let z=C.clamp(Math.ceil(Math.log2(width/(ratio*256))),2,12),N=2**z;let tileY=lat=>(1-Math.asinh(Math.tan(lat*Math.PI/180))/Math.PI)/2*N;let x0=Math.floor((minx+180)/360*N),x1=Math.floor((maxx+180)/360*N),y0=Math.floor(tileY(maxy)),y1=Math.floor(tileY(miny));let jobs=[];for(let y=y0;y<=y1;y++)for(let x=x0;x<=x1;x++)jobs.push([x,y]);if(jobs.length>100)throw Error('地形读取范围过大，请缩小区域');let tiles=new Map(),idx=0,done=0;
 async function worker(){while(idx<jobs.length){let[x,y]=jobs[idx++],key=`${z}/${x}/${y}`;if(signal.aborted)throw new DOMException('Cancelled','AbortError');let pixels=cache.get(key);if(!pixels){let r=await remote(`https://elevation-tiles-prod.s3.amazonaws.com/terrarium/${key}.png`,signal),bm=await createImageBitmap(await r.blob(),{colorSpaceConversion:'none',premultiplyAlpha:'none'}),cv=document.createElement('canvas');cv.width=cv.height=256;let ctx=cv.getContext('2d',{willReadFrequently:true});ctx.drawImage(bm,0,0);bm.close();pixels=ctx.getImageData(0,0,256,256).data;cache.set(key,pixels);if(cache.size>160)cache.delete(cache.keys().next().value)}tiles.set(`${x}/${y}`,pixels);done++;onProgress(done/jobs.length)}}try{await Promise.all(Array.from({length:Math.min(5,jobs.length)},worker))}catch(e){child.abort();throw e}finally{parentSignal.removeEventListener('abort',abort)}let a=new Float32Array(width*height);for(let j=0;j<height;j++){let py=tileY(maxy-(j+.5)/height*(maxy-miny));for(let i=0;i<width;i++){let px=(minx+(i+.5)/width*(maxx-minx)+180)/360*N,t=tiles.get(`${Math.floor(px)}/${Math.floor(py)}`),o=(Math.floor(py%1*256)*256+Math.floor(px%1*256))*4;a[j*width+i]=t[o]*256+t[o+1]+t[o+2]/256-32768}}return{values:Array.from(a),zoom:z}}
async function loadPopulation(bbox,width,height,year,resolution,signal){let p=new URLSearchParams({bbox:bbox.join(','),bboxSR:'4326',imageSR:'4326',size:`${width},${height}`,format:'tiff',pixelType:'F32',noData:'-9999',interpolation:'RSP_BilinearInterpolation',time:String(Date.UTC(year,0,1)),renderingRule:JSON.stringify({rasterFunction:'None'}),adjustAspectRatio:'false',f:'image'}),r=await remote(`https://worldpop.arcgis.com/arcgis/rest/services/WorldPop_Population_Density_${resolution}/ImageServer/exportImage?${p}`,signal),buf=await r.arrayBuffer();if(buf.byteLength<100)throw Error('人口服务没有返回栅格');let a=C.readFloatTiff(buf);if(a.width!==width||a.height!==height)throw Error('人口栅格尺寸与请求不一致');return Array.from(a.values,v=>Number.isFinite(v)?v:null)}
async function generate(){
 if(controller)return;
 let target;try{target=getSelected();C.validate(target.geo);ensureChina(target.geo,target.name)}catch(e){notice(e.message,'error');toast(e.message);return}
 const elev=$('elevation').checked,pop=$('population').checked,year=+$('year').value,resolution=$('resolution').value,online=$('dataMode').value==='online';
 if(!elev&&!pop){notice('请至少选择一个数据图层','error');return}
 const bbox=target.isChina?[73,18,135.5,54]:calcBounds(target.geo);
 if(pop&&resolution==='100m'&&(bbox[2]-bbox[0]>12||bbox[3]-bbox[1]>12)){notice('100 m 产品适合城市或小范围，请选择 1 km 或缩小区域','error');return}
 const selection={country:$('country').value,province:$('province').value,city:$('city').value,boundaryMode};
 const run=new AbortController();controller=run;startedAt=Date.now();let timeout=false;
 const timer=setTimeout(()=>{timeout=true;run.abort()},110000),clock=setInterval(()=>progress(currentStage,currentPercent),1000);
 const lockIds=['country','province','city','year','resolution','dataMode','elevation','population','presetTab','uploadTab','boundaryFile','uploadCrs'];const prior=lockIds.map(id=>[id,$(id).disabled]);for(let [id]of prior)$(id).disabled=true;$('generate').disabled=true;$('artwork').setAttribute('aria-busy','true');progress('正在准备 '+target.name+' 的数据…',5);
 try{
  let grid,insets=[],note='';const canSnapshot=year===2020&&resolution==='1km';
  if(!online&&canSnapshot&&availableSnapshot(target)){
   progress('正在读取 '+target.name+' 的真实数据快照…',25);
   try{grid=await getSnapshotGrid(target);note=grid.coarseCrop?'已按边界裁剪区域快照；采样较粗，可切换实时读取':'使用内置真实数据快照'}catch(e){if(e.message.includes('采样单元'))note=e.message+'；已尝试实时读取';else throw e}
  }
  if(!grid){
   const aspect=(bbox[2]-bbox[0])*Math.cos((bbox[1]+bbox[3])/2*Math.PI/180)/(bbox[3]-bbox[1]),width=aspect>=1?768:Math.max(256,Math.round(768*aspect)),height=aspect>=1?Math.max(256,Math.round(768/aspect)):768;
   grid={bbox,width,height,year,resolution,retrieved:new Intl.DateTimeFormat('sv-SE',{timeZone:'Asia/Shanghai'}).format(new Date())};
   try{
    if(elev){progress('正在联网读取高程瓦片…',8);const e=await loadTerrain(bbox,width,height,run.signal,n=>progress('正在联网读取高程瓦片… '+Math.round(n*100)+'%',8+n*42));grid.dem=e.values;grid.demZoom=e.zoom}
    if(pop){progress('正在联网读取 WorldPop '+year+' 年人口密度…',55);grid.pop=await loadPopulation(bbox,width,height,year,resolution,run.signal)}
    note='实时数据读取完成';
   }catch(e){
    if(run.signal.aborted||!canSnapshot||!availableSnapshot(target))throw e;
    progress('在线服务暂不可用，正在使用同年份真实快照…',70);grid=await getSnapshotGrid(target);note='在线服务暂不可用，使用 2020 年真实快照'+(grid.coarseCrop?'裁剪（采样较粗）':'');
   }
  }
  if(run.signal.aborted)throw new DOMException('已取消','AbortError');
  if(target.isChina){progress('正在准备台湾、香港、澳门局部图…',86);insets=await makeInsets();if(year!==2020||resolution!=='1km'){for(let ins of insets){if(pop)ins.grid.pop=await loadPopulation(ins.grid.bbox,ins.grid.width,ins.grid.height,year,resolution,run.signal);ins.grid.year=year;ins.grid.resolution=resolution;ins.stats=statistics(ins.grid,ins.geo)}}}
  if(!elev){delete grid.dem;for(let ins of insets)delete ins.grid.dem}if(!pop){delete grid.pop;for(let ins of insets)delete ins.grid.pop}
  progress('数据已就绪，正在绘制 '+target.name+'…',94);await new Promise(r=>setTimeout(r,0));if(run.signal.aborted)throw new DOMException('已取消','AbortError');
  const stats=statistics(grid,target.geo);if(elev&&stats.eCoverage===0||pop&&stats.pCoverage===0)throw Error('所选区域没有有效覆盖数据，请检查边界和数据源');
  Object.assign(state,target,{grid,insets,stats,...selection});state.view=elev&&pop?'overlay':elev?'elevation':'population';refreshMetrics();render();
  $('status').textContent=`已生成 ${target.name} · ${grid.year} 年 · ${grid.width} × ${grid.height} 采样 · ${note}`;$('dataHint').textContent=note+'。样式调整即时生效。';notice('已生成 '+target.name+' · '+note,'success');toast('地图已生成，可调整样式或导出作品');
 }catch(e){
  const message=run.signal.aborted?(timeout?'数据读取超时，请重试或选择“优先内置数据”':'已取消数据读取，保留上一幅地图'):`${target.name} 生成失败：${e.message}。请检查网络，或改用 2020 年 / 1 km 内置数据。`;
  $('status').textContent=message;$('dataHint').textContent=message;notice(message,'error');toast(message);run.abort();
 }finally{clearTimeout(timer);clearInterval(clock);controller=null;startedAt=0;for(let [id,disabled]of prior)$(id).disabled=disabled;$('generate').disabled=false;$('progressBox').hidden=true;$('artwork').removeAttribute('aria-busy')}
}
function exportGuard(){if(!state.grid)throw Error('请先生成地图');ensureChina(state.geo,state.name);ensureChina(state.geo,$('mapTitle').value)}
function download(blob,name){let u=URL.createObjectURL(blob),a=document.createElement('a');a.href=u;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),30000);toast('已发起下载，请在浏览器下载列表中查看')}
const filename=ext=>`${state.name.replace(/[\\/:*?"<>|]/g,'_')}_${state.view}_${state.grid.year}.${ext}`;
function showInfo(){if(state.grid){const t=state.stats;$('activeMetadata').textContent=`当前：${state.name} / ${state.grid.year} 年 / ${state.grid.resolution||'1km'} / ${state.grid.width}×${state.grid.height} 采样；人口视觉上限 P99.7 = ${Math.round(t.pCap).toLocaleString()} 人/km²。地形瓦片缩放级别 ${state.grid.demZoom??'—'}。`;}$('infoDialog').showModal()}
async function init(){
 $('generate').disabled=true;
 for(let y=2020;y>=2000;y--)$('year').add(new Option(y+' 年',y));
 try{[rawChina,world,presetManifest]=await Promise.all([fileJson('data/china.json'),fileJson('data/world.json'),fileJson('data/preset-manifest.json')]);china=converted(asFc(rawChina.features.filter(f=>typeof f.properties.adcode==='number')));for(let code of [710000,810000,820000])if(!china.features.some(f=>f.properties.adcode===code))throw Error('中国边界缺少台港澳要素');china.features.forEach(f=>$('province').add(new Option(f.properties.name,f.properties.adcode)));world.features.sort((a,b)=>a.properties.name.localeCompare(b.properties.name,'zh-CN')).forEach(f=>$('country').add(new Option(f.properties.name+(f.properties.code==='USA'?'（本土48州）':f.properties.code==='FRA'?'（欧洲本土）':''),f.properties.code)));state.geo=china;state.grid=await fileJson('data/china-grid.json');state.insets=await makeInsets();state.stats=statistics(state.grid,china);refreshMetrics();render();$('status').textContent='已加载中国真实数据快照 · 2020 年人口 · 含台港澳与南海诸岛';}catch(e){$('status').textContent=e.message;$('artwork').textContent='数据加载失败：'+e.message;notice('初始数据加载失败：'+e.message,'error')}finally{$('generate').disabled=false}
}
$('generate').onclick=generate;$('cancel').onclick=()=>controller?.abort();
$('country').onchange=()=>{$('chinaControls').hidden=$('country').value!=='CHN';$('scopeNote').textContent=$('country').value==='CHN'?'全国图含南海诸岛及台港澳局部图':'Natural Earth 概化边界 · 可上传精细边界替换';controlsChanged()};
let cityReq=0;$('province').onchange=async()=>{controlsChanged();cities=null;$('city').replaceChildren(new Option('全省 / 全区域','all'));let code=$('province').value,req=++cityReq;$('cityWrap').hidden=code==='all';if(code==='all'){$('scopeNote').textContent='全国图含南海诸岛及台港澳局部图';return}$('scopeNote').textContent='省级边界已就绪，正在准备下一级行政区';$('city').disabled=true;try{if(code==='710000'){throw Error('内置源暂未提供台湾下一级边界，可上传 GeoJSON')}let g=await fileJson(`data/admin/${code}.json`);if(req!==cityReq)return;cities=converted(g);cities.features.forEach(f=>$('city').add(new Option(f.properties.name,f.properties.adcode)));$('scopeNote').textContent=`已载入 ${cities.features.length} 个下一级行政区`}catch(e){if(req===cityReq)$('scopeNote').textContent='下一级边界暂不可用：'+e.message+'；当前省级范围仍可生成。'}finally{if(req===cityReq)$('city').disabled=false}};
$('city').onchange=controlsChanged;['year','resolution','dataMode','elevation','population'].forEach(id=>$(id).onchange=controlsChanged);
function boundaryTab(mode){boundaryMode=mode;$('presetPane').hidden=mode!=='preset';$('uploadPane').hidden=mode!=='upload';$('presetTab').classList.toggle('active',mode==='preset');$('uploadTab').classList.toggle('active',mode==='upload');controlsChanged()}
$('presetTab').onclick=()=>boundaryTab('preset');$('uploadTab').onclick=()=>boundaryTab('upload');
function updateUpload(){if(!uploadRaw)return;upload=$('uploadCrs').value==='gcj'?C.transform(uploadRaw,C.gcjInverse):uploadRaw;C.validate(upload);let f=C.features(upload);if(!f[0].properties)f[0].properties={};if(!f[0].properties.name)f[0].properties.name='自定义区域';$('uploadNote').textContent=`已加载 ${f.length} 个面要素 · 点击生成地图`}
$('boundaryFile').onchange=async e=>{let f=e.target.files[0];if(!f)return;try{if(f.size>12*1024*1024)throw Error('文件超过 12 MB，请简化边界后上传');uploadRaw=C.validate(JSON.parse(await f.text()));updateUpload();toast('边界已读取')}catch(e){upload=uploadRaw=null;$('uploadNote').textContent=e.message;toast(e.message)}e.target.value=''};$('uploadCrs').onchange=()=>{try{updateUpload()}catch(e){toast(e.message)}};
for(let id of ['lines','height','popHeight'])$(id).oninput=()=>{$(id+'Value').value=$(id).value;requestRender()};['curve','lineWidth','mapTitle','labels'].forEach(id=>$(id).addEventListener('input',requestRender));
for(let b of document.querySelectorAll('[data-view]'))b.onclick=()=>{let v=b.dataset.view;if((v==='population'||v==='overlay'||v==='triptych')&&!state.grid?.pop||(v==='elevation'||v==='overlay'||v==='triptych')&&!state.grid?.dem){toast('请启用相应数据图层并重新生成');return}state.view=v;requestRender()};
for(let b of document.querySelectorAll('[data-palette]'))b.onclick=()=>{state.palette=b.dataset.palette;document.querySelectorAll('[data-palette]').forEach(a=>a.classList.toggle('active',a===b));requestRender()};
$('reset').onclick=()=>{for(let[id,v]of Object.entries({lines:150,height:85,popHeight:75})){ $(id).value=v;$(id+'Value').value=v}$('curve').value='sqrt';$('lineWidth').value='1';$('mapTitle').value='山川与人海';$('labels').checked=true;state.palette='atlas';document.querySelectorAll('[data-palette]').forEach(b=>b.classList.toggle('active',b.dataset.palette==='atlas'));requestRender();toast('视觉样式已重置')};
$('fit').onclick=()=>{$('canvasWrap').scrollIntoView({behavior:'smooth',block:'center'});requestRender()};$('workspaceTab').onclick=()=>window.scrollTo({top:0,behavior:'smooth'});$('aboutButton').onclick=showInfo;$('metadataOpen').onclick=showInfo;$('exportOpen').onclick=()=>{try{exportGuard();$('exportDialog').showModal()}catch(e){toast(e.message)}};document.querySelectorAll('.dialog-close').forEach(b=>b.onclick=()=>b.closest('dialog').close());
$('saveSvg').onclick=()=>{try{exportGuard();download(new Blob([artSvg],{type:'image/svg+xml;charset=utf-8'}),filename('svg'))}catch(e){toast(e.message)}};
$('savePng').onclick=async()=>{let b=$('savePng');b.disabled=true;try{exportGuard();let size=+$('exportSize').value,svg=new Blob([artSvg],{type:'image/svg+xml'}),u=URL.createObjectURL(svg),im=new Image();await new Promise((r,j)=>{im.onload=r;im.onerror=()=>j(Error('图片渲染失败'));im.src=u});let cv=document.createElement('canvas');cv.width=size;cv.height=Math.round(size*940/1200);cv.getContext('2d').drawImage(im,0,0,cv.width,cv.height);URL.revokeObjectURL(u);let blob=await new Promise(r=>cv.toBlob(r,'image/png'));if(!blob)throw Error('浏览器未能创建图片，请降低导出尺寸');download(blob,filename('png'))}catch(e){toast(e.message)}finally{b.disabled=false}};
$('saveCsv').onclick=()=>{try{exportGuard();let g=state.grid,m=getMask(state.geo,g.bbox,g.width,g.height),a=['longitude,latitude,elevation_m,population_density_per_km2,population_year'];for(let j=0;j<g.height;j++)for(let i=0;i<g.width;i++){let k=j*g.width+i;if(m[k*4+3]<128)continue;let lon=g.bbox[0]+(i+.5)/g.width*(g.bbox[2]-g.bbox[0]),lat=g.bbox[3]-(j+.5)/g.height*(g.bbox[3]-g.bbox[1]),e=g.dem?.[k],p=g.pop?.[k];a.push(`${lon.toFixed(6)},${lat.toFixed(6)},${Number.isFinite(e)&&e!==-9999?e.toFixed(2):''},${Number.isFinite(p)&&p>=0?p.toFixed(3):''},${g.year}`)}download(new Blob(['\ufeff'+a.join('\r\n')],{type:'text/csv;charset=utf-8'}),filename('csv'))}catch(e){toast(e.message)}};
$('saveProject').onclick=()=>{try{exportGuard();download(new Blob([JSON.stringify({format:'ridge-atlas-v1',state,settings:getSettings(),sources:{elevation:'https://registry.opendata.aws/terrain-tiles/',population:'https://worldpop.arcgis.com/arcgis/rest/services/',boundary:state.boundarySource}})],{type:'application/json'}),filename('ridge.json'))}catch(e){toast(e.message)}};
$('projectFile').onchange=async e=>{let f=e.target.files[0];if(!f)return;try{if(f.size>40*1024*1024)throw Error('项目文件超过 40 MB');let p=JSON.parse(await f.text());if(p.format!=='ridge-atlas-v1'||!p.state?.grid)throw Error('不是有效的山川人海项目');C.validate(p.state.geo);ensureChina(p.state.geo,p.state.name);let g=p.state.grid;if(g.width*g.height>1200000||!g.bbox||(!g.dem&&!g.pop))throw Error('项目栅格尺寸或数据无效');if((g.dem&&g.dem.length!==g.width*g.height)||(g.pop&&g.pop.length!==g.width*g.height))throw Error('项目栅格长度不符');if(!PALETTES[p.state.palette])p.state.palette='atlas';if(!['overlay','elevation','population','triptych'].includes(p.state.view))p.state.view='overlay';if(p.state.isChina){if(!Array.isArray(p.state.insets)||p.state.insets.length!==3)throw Error('中国项目缺少台港澳局部图');for(let ins of p.state.insets){C.validate(ins.geo);if(!ins.grid||ins.grid.width*ins.grid.height>1200000)throw Error('局部图栅格无效')}}state=p.state;state.stats=statistics(state.grid,state.geo);for(let ins of state.insets||[])ins.stats=statistics(ins.grid,ins.geo);$('year').value=String(state.grid.year);$('resolution').value=state.grid.resolution||'1km';$('elevation').checked=!!state.grid.dem;$('population').checked=!!state.grid.pop;upload=state.geo;uploadRaw=state.geo;$('uploadNote').textContent='已恢复项目中的边界，可重新读取数据';boundaryTab('upload');document.querySelectorAll('[data-palette]').forEach(b=>b.classList.toggle('active',b.dataset.palette===state.palette));for(let id of ['lines','height','popHeight','curve','lineWidth'])if(p.settings[id]!==undefined)$(id).value=p.settings[id];$('mapTitle').value=p.settings.title||'山川与人海';$('labels').checked=p.settings.labels!==false;for(let id of ['lines','height','popHeight'])$(id+'Value').value=$(id).value;refreshMetrics();render();$('status').textContent='已从项目文件恢复地图 · 可离线调图与导出';$('exportDialog').close();toast('制图项目已恢复')}catch(e){toast('恢复失败：'+e.message)}e.target.value=''};
init();
</script><script>(function(){
 const button=document.getElementById('downloadLocal');
 if(!button||window.RIDGE_PACKED||window.RIDGE_BUNDLE)return;
 let busy=false;
 button.removeAttribute('download');
 button.addEventListener('click',async event=>{
  event.preventDefault();if(busy)return;busy=true;const label=button.textContent;
  const status=document.getElementById('downloadStatus');
  const message=text=>{button.textContent=text;if(status)status.textContent=text};
  try{
   const response=await RidgeData.boundedFetch('offline/manifest.json');const manifest=await response.json(),chunks=[];
   for(let i=0;i<manifest.parts.length;i++){
    message('准备本地工具 '+Math.round(i/manifest.parts.length*100)+'%…');
    const r=await RidgeData.boundedFetch(manifest.parts[i],{timeoutMs:60000,attempts:2});chunks.push(await r.arrayBuffer());
   }
   const file=new Blob(chunks,{type:'text/html;charset=utf-8'});
   if(file.size!==manifest.bytes)throw Error('下载不完整，请重试');
   const url=URL.createObjectURL(file),link=document.createElement('a');link.href=url;link.download='山川人海_本地工作台.html';link.click();setTimeout(()=>URL.revokeObjectURL(url),60000);
   message('已下载本地 HTML ✓');
  }catch(e){message('下载失败，点击重试');if(status)status.textContent=e.message;else if(typeof toast==='function')toast('下载失败：'+e.message)}
  finally{busy=false;setTimeout(()=>button.textContent=label,6000)}
 });
})();
</script></body></html>
