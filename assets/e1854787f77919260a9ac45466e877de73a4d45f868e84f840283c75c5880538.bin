async function remote(url,signal){return RidgeData.boundedFetch(url,{signal,onRetry:()=>progress(currentStage+' · 正在重试',currentPercent)})}
function isAbort(e){return e.name==='AbortError'}
function notice(message,kind='busy'){$('taskNotice').hidden=false;$('taskNotice').textContent=message;$('taskNotice').dataset.kind=kind}
function progress(t,n){currentStage=t;currentPercent=n;const secs=startedAt?Math.floor((Date.now()-startedAt)/1000):0;$('progressBox').hidden=false;$('progressText').textContent=t+(secs?' · 已用时 '+secs+' 秒':'');$('progressBar').style.width=n+'%';notice(t+(secs?' · '+secs+' 秒':''));$('status').textContent=t}
async function snapshot(key){const meta=presetManifest[key];if(!meta)throw Error('当前区域没有内置快照');if(!snapshotCache.has(key)){const g=await fileJson(meta.path);g.snapshot=true;snapshotCache.set(key,g);if(snapshotCache.size>4)snapshotCache.delete(snapshotCache.keys().next().value)}return structuredClone(snapshotCache.get(key))}
function availableSnapshot(target){
