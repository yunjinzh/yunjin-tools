})(typeof window!=='undefined'?window:globalThis);
</script><script>'use strict';
const C=RidgeCore,$=id=>document.getElementById(id),PALETTES={atlas:{bg:'#fafaf5',ink:'#293a31',e:'#8c9771',p:'#704d66',muted:'#9ba38e'},clay:{bg:'#fcf5eb',ink:'#563e35',e:'#c28365',p:'#456771',muted:'#a39482'},ink:{bg:'#f4f5ef',ink:'#273b40',e:'#8b9693',p:'#293f46',muted:'#8c9a96'},night:{bg:'#202e2e',ink:'#e3e9d7',e:'#b9c7a0',p:'#e1a0b9',muted:'#82968d'}};
let state={country:'CHN',name:'中国',en:'CHINA',view:'overlay',palette:'atlas',grid:null,geo:null,isChina:true,boundarySource:'DataV GeoAtlas',insets:[]},rawChina,china,world,upload=null,uploadRaw=null,boundaryMode='preset',cities=null,controller=null,artSvg='',raf=0,toastTimer,presetManifest={},startedAt=0,currentStage='',currentPercent=0;const cache=new Map();const snapshotCache=new Map();
const esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&apos;'}[c]));
function toast(s){$('toast').textContent=s;$('toast').hidden=false;clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('toast').hidden=true,5200)}
async function fileJson(path){
 if(window.RIDGE_BUNDLE?.[path])return structuredClone(window.RIDGE_BUNDLE[path]);
 if(window.RIDGE_PACKED?.[path])return RidgeData.unpack(window.RIDGE_PACKED[path]);
