 const choices=Object.entries(presetManifest).filter(([k,m])=>m.bbox&&m.bbox[0]<=bbox[0]&&m.bbox[1]<=bbox[1]&&m.bbox[2]>=bbox[2]&&m.bbox[3]>=bbox[3]).sort((a,b)=>(a[1].bbox[2]-a[1].bbox[0])*(a[1].bbox[3]-a[1].bbox[1])-(b[1].bbox[2]-b[1].bbox[0])*(b[1].bbox[3]-b[1].bbox[1]));
 return choices.length?{key:choices[0][0],exact:false}:null;
}
async function getSnapshotGrid(target){const match=availableSnapshot(target);if(!match)throw Error('边界不在内置快照范围内');const g=await snapshot(match.key);return match.exact?g:RidgeData.crop(g,C.bounds(target.geo))}
function converted(g){return {type:'FeatureCollection',features:C.features(g).map(f=>C.transform(f,a=>f.properties?.adcode===710000?a:C.gcjInverse(a)))}}
function asFc(fs){return{type:'FeatureCollection',features:fs}}
function shortName(f){return f.properties.name||f.properties.NAME||'自定义区域'}
function controlsChanged(){$('dataHint').textContent='范围或数据设置已变更，点击「生成地图」应用。';}
function getSettings(){return{lines:+$('lines').value,height:+$('height').value,popHeight:+$('popHeight').value,curve:$('curve').value,lineWidth:+$('lineWidth').value,title:$('mapTitle').value,labels:$('labels').checked}}
function getSelected(){
 if(boundaryMode==='upload'){if(!upload)throw Error('请先选择 GeoJSON 文件');return{geo:upload,name:shortName(C.features(upload)[0]),en:'CUSTOM REGION',isChina:false,boundarySource:$('uploadCrs').value==='gcj'?'用户 GeoJSON / GCJ-02 近似转换':'用户 GeoJSON / WGS84'}}
 if($('country').value==='CHN'){
  if($('province').value==='all')return{geo:china,name:'中国',en:'CHINA',isChina:true,presetKey:'CHN',boundarySource:'DataV GeoAtlas / GCJ-02 近似转换'};
  let f=china.features.find(f=>String(f.properties.adcode)===$('province').value);
  if(cities&&$('city').value!=='all')f=cities.features.find(f=>String(f.properties.adcode)===$('city').value)||f;
  return{geo:asFc([f]),name:f.properties.name,en:'CHINA / REGIONAL STUDY',isChina:false,presetKey:$('city').value==='all'?'cn-'+$('province').value:null,parentPresetKey:'cn-'+$('province').value,boundarySource:'DataV GeoAtlas / GCJ-02 近似转换'};
 }
 let f=world.features.find(f=>f.properties.code===$('country').value);return{geo:asFc([f]),name:f.properties.name+(f.properties.code==='USA'?'（本土48州）':f.properties.code==='FRA'?'（欧洲本土）':''),en:f.properties.name_en.toUpperCase(),isChina:false,presetKey:f.properties.code==='AUS'?'AUS':'country-'+f.properties.code,boundarySource:'Natural Earth 1:110m / public domain'};
}
function calcBounds(g){let b=C.bounds(g),dx=(b[2]-b[0])*.015,dy=(b[3]-b[1])*.015;return[b[0]-dx,b[1]-dy,b[2]+dx,b[3]+dy]}
function getMask(geo,bbox,w,h){let cv=document.createElement('canvas');cv.width=w;cv.height=h;let ctx=cv.getContext('2d',{willReadFrequently:true});ctx.fillStyle='#fff';for(let poly of C.polygons(geo)){ctx.beginPath();for(let ring of poly){ring.forEach(([x,y],i)=>{let a=(x-bbox[0])/(bbox[2]-bbox[0])*w,b=(bbox[3]-y)/(bbox[3]-bbox[1])*h;if(!i)ctx.moveTo(a,b);else ctx.lineTo(a,b)});ctx.closePath()}ctx.fill('evenodd')}return ctx.getImageData(0,0,w,h).data}
function statistics(grid,geo){let mask=getMask(geo,grid.bbox,grid.width,grid.height),e=[],p=[],inside=0,zero=0;for(let i=0;i<grid.width*grid.height;i++){if(mask[i*4+3]<128)continue;inside++;let a=grid.dem?.[i],b=grid.pop?.[i];if(Number.isFinite(a)&&a!==-9999)e.push(a);if(Number.isFinite(b)&&b>=0){p.push(b);if(!b)zero++}}return{eMin:e.length?Math.min(...e.slice(0,1)):0,eMax:C.quantile(e,.99),eLow:C.quantile(e,.01),pMax:C.quantile(p,1),eCap:Math.max(1,C.quantile(e,.995)),pCap:Math.max(1,C.quantile(p,.997)),eCoverage:inside?e.length/inside:0,pCoverage:inside?p.length/inside:0,inside,zero};}
function svgText(x,y,txt,size,color,extra=''){return `<text x="${x}" y="${y}" fill="${color}" font-size="${size}" ${extra}>${esc(txt)}</text>`}
function outline(geo,bbox,x,y,w,h,color,opacity=1){let s='';for(let poly of C.polygons(geo))for(let ring of poly){let d=ring.map(([a,b],i)=>(i?'L':'M')+(x+(a-bbox[0])/(bbox[2]-bbox[0])*w).toFixed(2)+' '+(y+(bbox[3]-b)/(bbox[3]-bbox[1])*h).toFixed(2)).join(' ')+'Z';s+=`<path d="${d}" fill="none" stroke="${color}" stroke-width=".8" opacity="${opacity}"/>`}return s}
function ridgePlot(grid,geo,view,rect,s,stats,compact=false){
 const pal=PALETTES[state.palette],[rx,ry,rw,rh]=rect,b=grid.bbox,aspect=(b[2]-b[0])*Math.cos((b[1]+b[3])/2*Math.PI/180)/(b[3]-b[1]);
